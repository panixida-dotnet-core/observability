<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <IsPackable>true</IsPackable>
        <IsAotCompatible>true</IsAotCompatible>
        <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
        <PackageType>MSBuildSdk</PackageType>

        <AssemblyName>PANiXiDA.Core.Observability</AssemblyName>

        <PackageId>PANiXiDA.Core.Observability</PackageId>
        <Description>MSBuild SDK and OpenTelemetry logging, metrics, and tracing conventions for ASP.NET Core servers and Blazor WebAssembly clients.</Description>
        <PackageTags>Observability;OpenTelemetry;Telemetry;Tracing;Metrics;Logging;DistributedTracing;Diagnostics;DotNet;Blazor;WebAssembly</PackageTags>

        <RepositoryUrl>https://github.com/panixida-dotnet-core/observability</RepositoryUrl>
        <PackageProjectUrl>https://github.com/panixida-dotnet-core/observability</PackageProjectUrl>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Nerdbank.GitVersioning">
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" ObservabilityHost="Browser" PrivateAssets="all" />
        <PackageReference Include="Npgsql.OpenTelemetry" ObservabilityHost="Server" PrivateAssets="all" />
        <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" ObservabilityHost="Common" PrivateAssets="all" />
        <PackageReference Include="OpenTelemetry.Extensions.Hosting" ObservabilityHost="Common" PrivateAssets="all" />
        <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" ObservabilityHost="Server" PrivateAssets="all" />
        <PackageReference Include="OpenTelemetry.Instrumentation.Http" ObservabilityHost="Common" PrivateAssets="all" />
        <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" ObservabilityHost="Server" PrivateAssets="all" />
        <PackageReference Include="System.Threading.RateLimiting" ObservabilityHost="Browser" PrivateAssets="all" />
        <PackageReference Include="Yarp.Telemetry.Consumption" ObservabilityHost="Server" PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="PANiXiDA.Core.Observability.UnitTests" />
    </ItemGroup>
</Project>
