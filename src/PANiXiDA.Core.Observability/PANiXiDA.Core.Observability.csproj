<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <IsPackable>true</IsPackable>
        <IsTrimmable>true</IsTrimmable>
        <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>

        <AssemblyName>PANiXiDA.Core.Observability</AssemblyName>

        <PackageId>PANiXiDA.Core.Observability</PackageId>
        <Description>OpenTelemetry logging, metrics, and tracing conventions for ASP.NET Core servers and Blazor WebAssembly clients.</Description>
        <PackageTags>Observability;OpenTelemetry;Telemetry;Tracing;Metrics;Logging;DistributedTracing;Diagnostics;DotNet;Blazor;WebAssembly</PackageTags>

        <RepositoryUrl>https://github.com/panixida-dotnet-core/observability</RepositoryUrl>
        <PackageProjectUrl>https://github.com/panixida-dotnet-core/observability</PackageProjectUrl>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Nerdbank.GitVersioning">
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
        <PackageReference Include="Microsoft.Extensions.Http" />
        <PackageReference Include="Npgsql.OpenTelemetry" />
        <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
        <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
        <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
        <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
        <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="PANiXiDA.Core.Observability.WebAssembly.UnitTests" />
    </ItemGroup>
</Project>
