@using System.Diagnostics
@using System.Diagnostics.Metrics
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.Extensions.Logging
@inject HttpClient Http
@inject ILogger<App> Logger

<h1>Browser telemetry smoke</h1>
<button @onclick="ExportAsync">Export telemetry</button>
<p id="result">@result</p>

@code {
    private static readonly ActivitySource Source = new("BrowserSmoke");
    private static readonly Meter Meter = new("BrowserSmoke");
    private static readonly Counter<long> Actions = Meter.CreateCounter<long>("browser.smoke.actions");
    private string result = "Ready";

    private async Task ExportAsync()
    {
        using var activity = Source.StartActivity("browser-smoke-action");
        Logger.LogWarning("Browser smoke action");
        Actions.Add(1);
        var response = await Http.GetStringAsync("probe");
        result = $"Exported; HTTP traceparent: {response}";
    }
}
